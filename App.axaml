<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Circle_Tracker.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <Color x:Key="BackgroundDarkColor">#161320</Color>
        <Color x:Key="CardBackgroundColor">#201a30</Color>
        <Color x:Key="CardBorderColor">#332a4d</Color>
        <Color x:Key="ChipBackgroundColor">#2b2244</Color>
        <Color x:Key="AccentPinkColor">#ff5599</Color>
        <Color x:Key="AccentPurpleColor">#9333ea</Color>
        <Color x:Key="AccentCyanColor">#38bdf8</Color>
        <Color x:Key="AccentGreenColor">#4ade80</Color>
        <Color x:Key="AccentOrangeColor">#fb923c</Color>
        <Color x:Key="AccentRedColor">#f87171</Color>
        <Color x:Key="AccentGoldColor">#facc15</Color>
        <Color x:Key="TextPrimaryColor">#f1f0f7</Color>
        <Color x:Key="TextMutedColor">#938ba8</Color>

        <SolidColorBrush x:Key="BackgroundDark" Color="#161320" />
        <SolidColorBrush x:Key="CardBackground" Color="#201a30" />
        <SolidColorBrush x:Key="CardBorder" Color="#332a4d" />
        <SolidColorBrush x:Key="ChipBackground" Color="#2b2244" />
        <SolidColorBrush x:Key="AccentPink" Color="#ff5599" />
        <SolidColorBrush x:Key="AccentPurple" Color="#9333ea" />
        <SolidColorBrush x:Key="AccentCyan" Color="#38bdf8" />
        <SolidColorBrush x:Key="AccentGreen" Color="#4ade80" />
        <SolidColorBrush x:Key="AccentOrange" Color="#fb923c" />
        <SolidColorBrush x:Key="AccentRed" Color="#f87171" />
        <SolidColorBrush x:Key="AccentGold" Color="#facc15" />
        <SolidColorBrush x:Key="TextPrimary" Color="#f1f0f7" />
        <SolidColorBrush x:Key="TextMuted" Color="#938ba8" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Border.hud-card">
            <Setter Property="Background" Value="#201a30" />
            <Setter Property="BorderBrush" Value="#332a4d" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.stat-chip">
            <Setter Property="Background" Value="#2b2244" />
            <Setter Property="BorderBrush" Value="#3a3055" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="Border.status-pill">
            <Setter Property="Background" Value="#201a30" />
            <Setter Property="BorderBrush" Value="#332a4d" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="Button.primary-gradient">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#ff5599" />
                    <GradientStop Offset="1" Color="#9333ea" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary-gradient:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#ff66aa" />
                    <GradientStop Offset="1" Color="#a855f7" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.secondary-flat">
            <Setter Property="Background" Value="#2b2244" />
            <Setter Property="Foreground" Value="#f1f0f7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="#3a3055" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.secondary-flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3055" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>

        <Style Selector="TextBox.osu-input">
            <Setter Property="Background" Value="#1a1528" />
            <Setter Property="Foreground" Value="#f1f0f7" />
            <Setter Property="BorderBrush" Value="#3a3055" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="TextBox.osu-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#ff5599" />
            <Setter Property="Background" Value="#1a1528" />
        </Style>

        <Style Selector="CheckBox.osu-check">
            <Setter Property="Foreground" Value="#f1f0f7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Application.Styles>
</Application>
