<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Circle_Tracker"
             x:Class="Circle_Tracker.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <FontFamily x:Key="OsuFont">avares://circle-tracker/Assets/Fonts#Torus, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif</FontFamily>

        <Color x:Key="BackgroundDarkColor">#14121d</Color>
        <Color x:Key="CardBackgroundColor">#cc1d192b</Color>
        <Color x:Key="CardBorderColor">#2e2744</Color>
        <Color x:Key="ChipBackgroundColor">#252038</Color>
        <Color x:Key="AccentPinkColor">#e11d48</Color>
        <Color x:Key="AccentPurpleColor">#a855f7</Color>
        <Color x:Key="AccentCyanColor">#7dd3fc</Color>
        <Color x:Key="AccentGreenColor">#4ade80</Color>
        <Color x:Key="AccentOrangeColor">#fb923c</Color>
        <Color x:Key="AccentRedColor">#f87171</Color>
        <Color x:Key="AccentGoldColor">#facc15</Color>
        <Color x:Key="TextPrimaryColor">#f5f4fa</Color>
        <Color x:Key="TextMutedColor">#8f87a3</Color>

        <SolidColorBrush x:Key="BackgroundDark" Color="#14121d" />
        <SolidColorBrush x:Key="CardBackground" Color="#cc1d192b" />
        <SolidColorBrush x:Key="CardBorder" Color="#2e2744" />
        <SolidColorBrush x:Key="ChipBackground" Color="#252038" />
        <SolidColorBrush x:Key="AccentPink" Color="#e11d48" />
        <SolidColorBrush x:Key="AccentPurple" Color="#a855f7" />
        <SolidColorBrush x:Key="AccentCyan" Color="#7dd3fc" />
        <SolidColorBrush x:Key="AccentGreen" Color="#4ade80" />
        <SolidColorBrush x:Key="AccentOrange" Color="#fb923c" />
        <SolidColorBrush x:Key="AccentRed" Color="#f87171" />
        <SolidColorBrush x:Key="AccentGold" Color="#facc15" />
        <SolidColorBrush x:Key="TextPrimary" Color="#f5f4fa" />
        <SolidColorBrush x:Key="TextMuted" Color="#8f87a3" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource OsuFont}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource OsuFont}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource OsuFont}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource OsuFont}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource OsuFont}" />
        </Style>

        <Style Selector="TextBlock.hero-number">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#f5f4fa" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#f5f4fa" />
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8f87a3" />
        </Style>
        <Style Selector="TextBlock.banner-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.banner-artist">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.hud-card">
            <Setter Property="Background" Value="#cc1d192b" />
            <Setter Property="BorderBrush" Value="#2e2744" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.hud-card:pointerover">
            <Setter Property="BorderBrush" Value="#433868" />
        </Style>

        <Style Selector="Border.status-pill">
            <Setter Property="Background" Value="#cc1d192b" />
            <Setter Property="BorderBrush" Value="#2e2744" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="Button.primary-action">
            <Setter Property="Background" Value="#e11d48" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#f43f5e" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>

        <Style Selector="Button.osu-action-pink">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" CornerRadius="8" ClipToBounds="True" Background="#e11d48">
                        <Grid ClipToBounds="True">
                            <local:TrianglesControl Velocity="16" TriangleCount="16" TriangleBrush="#38ffffff" IsHitTestVisible="False" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="16,10"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Foreground="White"
                                              FontWeight="Bold" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.osu-action-pink:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="#f43f5e" />
        </Style>

        <Style Selector="Button.osu-action-blue">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="RootBorder" CornerRadius="8" ClipToBounds="True" Background="#0284c7">
                        <Grid ClipToBounds="True">
                            <local:TrianglesControl Velocity="14" TriangleCount="16" TriangleBrush="#38ffffff" IsHitTestVisible="False" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="16,10"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Foreground="White"
                                              FontWeight="Bold" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.osu-action-blue:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="#38bdf8" />
        </Style>

        <Style Selector="Button.secondary-flat">
            <Setter Property="Background" Value="#252038" />
            <Setter Property="Foreground" Value="#f5f4fa" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#2e2744" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.secondary-flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#322b4a" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>

        <Style Selector="Button.ghost-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8f87a3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost-btn:pointerover TextBlock">
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>

        <Style Selector="TextBox.osu-input">
            <Setter Property="Background" Value="#171324" />
            <Setter Property="Foreground" Value="#f5f4fa" />
            <Setter Property="BorderBrush" Value="#2e2744" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox.osu-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#a855f7" />
            <Setter Property="Background" Value="#171324" />
        </Style>

        <Style Selector="CheckBox.osu-check">
            <Setter Property="Foreground" Value="#f5f4fa" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.link-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link-toggle:pointerover TextBlock">
            <Setter Property="Foreground" Value="#c4b5fd" />
        </Style>
    </Application.Styles>
</Application>
