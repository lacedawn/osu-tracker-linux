<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Circle_Tracker"
        xmlns:vm="using:Circle_Tracker.ViewModels"
        x:Class="Circle_Tracker.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Circle Tracker"
        Width="600"
        MinWidth="560"
        Height="380"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#14121d">

  <Panel>
    <local:TrianglesControl x:Name="BackgroundTriangles" Velocity="6" TriangleCount="18" TriangleBrush="#0effffff" IsHitTestVisible="False"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="16">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10" Height="24">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{Binding TosuStatusBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TosuStatusText}" Foreground="#8f87a3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{Binding DbStatusBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding DbStatusText}" Foreground="#8f87a3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Column="1" Text="{Binding GameState}" Foreground="{Binding GameStateBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <Button Grid.Column="2" Classes="ghost-btn" Command="{Binding ConnectSheetsCommand}" Padding="4,2" Cursor="Hand" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{Binding SheetsStatusBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SheetsStatusText}" Foreground="#8f87a3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <Border Grid.Row="1" Height="110" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,14" Background="#221c34">
          <Grid>
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
            <local:TrianglesControl x:Name="BannerTriangles" IsVisible="{Binding BannerTrianglesVisible}" Velocity="8" TriangleCount="14" TriangleBrush="#25ffffff" IsHitTestVisible="False"/>
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0.0" Color="#9914121d"/>
                  <GradientStop Offset="0.45" Color="#4014121d"/>
                  <GradientStop Offset="1.0" Color="#0014121d"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="14,10">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Classes="banner-title" Text="{Binding BeatmapTitle}" ToolTip.Tip="{Binding BeatmapTitle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Classes="banner-artist" Text="{Binding BeatmapArtist}" Foreground="#f1f0f7" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
                <Border CornerRadius="8" Background="#88000000" BorderThickness="0" Padding="8,4" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding BeatmapVersion}" FontSize="12" FontWeight="Bold" Foreground="#f5f4fa"/>
                </Border>
                <Border CornerRadius="8" Background="#88000000" BorderThickness="0" Padding="8,4" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding BeatmapStars}" FontSize="13" FontWeight="Bold" Foreground="#facc15"/>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <Grid Grid.Column="0" ColumnDefinitions="*,*,*,*" Margin="4,0,24,0" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
              <TextBlock Classes="stat-label" Text="CS"/>
              <TextBlock Classes="hero-stat-value" Text="{Binding StatCs}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
              <TextBlock Classes="stat-label" Text="AR"/>
              <TextBlock Classes="hero-stat-value" Text="{Binding StatAr}" Foreground="{Binding StatArBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Left">
              <TextBlock Classes="stat-label" Text="OD"/>
              <TextBlock Classes="hero-stat-value" Text="{Binding StatOd}" Foreground="{Binding StatOdBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" HorizontalAlignment="Left">
              <TextBlock Classes="stat-label" Text="HP"/>
              <TextBlock Classes="hero-stat-value" Text="{Binding StatHp}"/>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Classes="hero-number" Text="{Binding AccuracyText}" Foreground="{Binding AccuracyBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Border Grid.Column="1" CornerRadius="8" Background="#88000000" Padding="8,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding PlayCountBadge}" FontSize="11" FontWeight="Bold" Foreground="#facc15"/>
              </Border>
            </Grid>
            <TextBlock Classes="stat-label" Text="{Binding SessionTimeText}" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>

        <Rectangle Grid.Row="3" Height="1" Fill="#28223a" Margin="0,4,0,10"/>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <StackPanel Grid.Column="0" Spacing="4">
            <Grid ColumnDefinitions="*,*,*,*" Margin="4,0,24,0">
              <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                <TextBlock Classes="stat-label" Text="300"/>
                <TextBlock Text="{Binding Hits300}" FontSize="16" FontWeight="Bold" Foreground="#7dd3fc"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                <TextBlock Classes="stat-label" Text="100"/>
                <TextBlock Text="{Binding Hits100}" FontSize="16" FontWeight="Bold" Foreground="#4ade80"/>
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                <TextBlock Classes="stat-label" Text="50"/>
                <TextBlock Text="{Binding Hits50}" FontSize="16" FontWeight="Bold" Foreground="#fb923c"/>
              </StackPanel>
              <StackPanel Grid.Column="3" HorizontalAlignment="Left">
                <TextBlock Classes="stat-label" Text="MISS"/>
                <TextBlock Text="{Binding HitsMiss}" FontSize="16" FontWeight="Bold" Foreground="#f87171"/>
              </StackPanel>
            </Grid>
            <TextBlock Classes="stat-label" Text="{Binding TotalObjectsText}" Margin="4,0,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Right">
              <TextBlock Classes="stat-label" Text="BPM" HorizontalAlignment="Right"/>
              <TextBlock FontSize="16" FontWeight="Bold" Foreground="{Binding StatBpmBrush}" Text="{Binding StatBpm}" HorizontalAlignment="Right"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
              <TextBlock Classes="stat-label" Text="MODS" HorizontalAlignment="Right"/>
              <TextBlock FontSize="16" FontWeight="Bold" Foreground="{Binding StatModsBrush}" Text="{Binding StatMods}" HorizontalAlignment="Right"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Border Grid.Row="5" Classes="hud-card" Margin="0,0,0,10" IsVisible="{Binding LiveSessionCardVisible}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="LIVE SESSION INSIGHTS" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="11"/>
              <TextBlock Grid.Column="1" Text="{Binding SessionElapsedText}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
            </Grid>

            <Grid ColumnDefinitions="*,*,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Accuracy Δ" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Background="{StaticResource AccentGreen}">
                  <TextBlock Text="{Binding DeltaAccuracyText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Stars Δ" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Background="{StaticResource AccentGold}">
                  <TextBlock Text="{Binding DeltaStarsText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="BPM Δ" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Background="{StaticResource AccentOrange}">
                  <TextBlock Text="{Binding DeltaBpmText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding SessionStatsText}" Foreground="{StaticResource TextMuted}" FontSize="9"/>
          </StackPanel>
        </Border>

        <Border Classes="hud-card" Margin="0,0,0,10" IsVisible="{Binding AchievementBannerVisible}" Background="#cc1d192b" BorderBrush="{Binding AchievementAccentColor}" BorderThickness="2">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding AchievementTitle}" FontWeight="Bold" FontSize="12"/>
            <TextBlock Text="{Binding AchievementDescription}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Spacing="8">
          <Button Classes="osu-action-blue" Content="📊 ANALYTICS DASHBOARD" HorizontalAlignment="Center" Command="{Binding OpenAnalyticsCommand}" Margin="0,0,0,4"/>

          <Button x:Name="SettingsToggleButton" Classes="link-toggle" HorizontalAlignment="Center" Click="SettingsToggleButton_Click">
            <TextBlock x:Name="SettingsToggleText" Text="► More Settings" Foreground="#8f87a3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          </Button>

          <Border x:Name="SettingsPanel" Classes="hud-card" IsVisible="False" Margin="0,4,0,0">
            <Grid ColumnDefinitions="*,*" Margin="4">
              <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,10,0">
                <TextBlock Classes="stat-label" Text="DATA PERSISTENCE &amp; STORAGE" FontSize="10" FontWeight="Bold" Foreground="#8f87a3"/>
                <CheckBox Classes="osu-check" Content="Enable Local SQLite Logging" IsChecked="{Binding EnableLocalLogging}"/>
                <TextBox Classes="osu-input" Watermark="Database path (default: circle_tracker.db)" Text="{Binding LocalDatabasePath}"
                         ToolTip.Tip="Custom path for the SQLite database file"/>
                <CheckBox Classes="osu-check" Content="Play sound on play submission" IsChecked="{Binding SubmitSoundEnabled}"/>

                <TextBlock Classes="stat-label" Text="TOSU CLIENT &amp; APP" FontSize="10" FontWeight="Bold" Foreground="#8f87a3" Margin="0,8,0,0"/>
                <Grid ColumnDefinitions="*,8,80">
                  <TextBox Grid.Column="0" Classes="osu-input" Watermark="Host (127.0.0.1)" Text="{Binding TosuHost}"/>
                  <TextBox Grid.Column="2" Classes="osu-input" Watermark="Port (24050)" Text="{Binding TosuPortText}"/>
                </Grid>
                <CheckBox Classes="osu-check" Content="Launch on system startup" IsChecked="{Binding StartupLaunch}"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="8" Margin="10,0,0,0">
                <TextBlock Classes="stat-label" Text="GOOGLE SHEETS (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="#8f87a3"/>
                <CheckBox Classes="osu-check" Content="Enable Google Sheets Logging" IsChecked="{Binding EnableSheetsLogging}"/>
                <TextBox Classes="osu-input" Watermark="Spreadsheet ID" Text="{Binding SpreadsheetId}"
                         ToolTip.Tip="The ID from your Google Sheets URL"/>
                <TextBox Classes="osu-input" Watermark="Sheet Name" Text="{Binding SheetName}"
                         ToolTip.Tip="The sheet/tab name (default: Raw Data)"/>

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                  <Button Grid.Column="0" Classes="osu-action-pink" Content="Connect Sheets API" Command="{Binding ConnectSheetsCommand}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="stat-label" Text="credentials.json:" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CredentialsStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CredentialsStatusBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>

                <Button Classes="osu-action-blue"
                        Command="{Binding ImportSheetsCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="10,6"
                        Margin="0,6,0,0"
                        ToolTip.Tip="Import all existing plays from your Google Sheets into local database for analytics">
                  <TextBlock Text="📥 IMPORT SHEETS DATA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Button>

                <CheckBox Classes="osu-check" Content="Use ';' formula separator" IsChecked="{Binding UseAltFuncSeparator}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Panel>
</Window>
