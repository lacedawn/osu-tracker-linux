<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Circle_Tracker.MainWindow"
        Title="Circle Tracker"
        Width="640"
        MinWidth="600"
        Height="540"
        MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#14121d">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="10">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <Border Grid.Column="0" Classes="status-pill">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse x:Name="TosuStatusDot" Width="8" Height="8" Fill="#f87171"/>
          <TextBlock x:Name="TosuStatusText" Text="tosu: Connecting..." Foreground="#f5f4fa" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="status-pill" HorizontalAlignment="Center">
        <TextBlock x:Name="GameStateBadge" Text="IDLE" Foreground="#8f87a3" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
      </Border>

      <Border Grid.Column="2" Classes="status-pill">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse x:Name="SheetsStatusDot" Width="8" Height="8" Fill="#f87171"/>
          <TextBlock x:Name="SheetsStatusText" Text="Sheets: Not connected" Foreground="#f5f4fa" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Height="105" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,8" Background="#1d192b" BorderBrush="#2e2744" BorderThickness="1">
      <Grid>
        <Image x:Name="CoverImage" Stretch="UniformToFill" Opacity="0.85"/>
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#f014121d"/>
              <GradientStop Offset="1" Color="#8014121d"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Grid ColumnDefinitions="*,Auto" Margin="14,10">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="BeatmapTitleText" Text="No beatmap detected" FontSize="18" FontWeight="Bold" Foreground="#f5f4fa" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="BeatmapArtistText" Text="-" FontSize="13" FontWeight="Medium" Foreground="#c4b5fd" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
            <Border Background="#252038" BorderBrush="#2e2744" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
              <TextBlock x:Name="BeatmapVersionText" Text="-" FontSize="12" Foreground="#f5f4fa"/>
            </Border>
            <Border Background="#1d192b" BorderBrush="#2e2744" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
              <TextBlock x:Name="BeatmapStarsBadge" Text="★ 0.00" FontSize="14" FontWeight="Bold" Foreground="#facc15"/>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,8">
      <Border Grid.Column="0" Classes="hud-card" Margin="0,0,4,0">
        <StackPanel Spacing="6">
          <TextBlock Text="LIVE HITS" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3"/>
          <Grid ColumnDefinitions="*,*,*,*">
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
              <TextBlock Text="300" FontSize="11" Foreground="#8f87a3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="Hits300Text" Text="0" FontSize="18" FontWeight="Bold" Foreground="#7dd3fc" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock Text="100" FontSize="11" Foreground="#8f87a3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="Hits100Text" Text="0" FontSize="18" FontWeight="Bold" Foreground="#4ade80" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
              <TextBlock Text="50" FontSize="11" Foreground="#8f87a3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="Hits50Text" Text="0" FontSize="18" FontWeight="Bold" Foreground="#fb923c" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
              <TextBlock Text="MISS" FontSize="11" Foreground="#8f87a3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="HitsMissText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#f87171" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="TotalObjectsText" Text="Total: 0" FontSize="11" Foreground="#8f87a3" HorizontalAlignment="Right"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="hud-card" Margin="4,0,0,0">
        <StackPanel Spacing="6">
          <TextBlock Text="ACCURACY &amp; SESSION" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3"/>
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" x:Name="AccuracyText" Text="100.00%" FontSize="24" FontWeight="Bold" Foreground="#f5f4fa" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="status-pill" Background="#252038" VerticalAlignment="Center">
              <TextBlock x:Name="PlayCountBadge" Text="Play #0" FontSize="11" FontWeight="SemiBold" Foreground="#facc15"/>
            </Border>
          </Grid>
          <TextBlock x:Name="SessionTimeText" Text="Playing: 0m  Idle: 0m (0%)" FontSize="11" Foreground="#8f87a3"/>
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Spacing="8">
      <Border Classes="hud-card">
        <Grid ColumnDefinitions="*,*,*,*,*,2*">
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock Text="CS" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatCsText" Text="0.0" FontSize="13" FontWeight="Bold" Foreground="#f5f4fa" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="AR" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatArText" Text="0.0" FontSize="13" FontWeight="Bold" Foreground="#f5f4fa" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="OD" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatOdText" Text="0.0" FontSize="13" FontWeight="Bold" Foreground="#f5f4fa" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="3" HorizontalAlignment="Center">
            <TextBlock Text="HP" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatHpText" Text="0.0" FontSize="13" FontWeight="Bold" Foreground="#f5f4fa" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="4" HorizontalAlignment="Center">
            <TextBlock Text="BPM" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatBpmText" Text="0" FontSize="13" FontWeight="Bold" Foreground="#f5f4fa" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="5" HorizontalAlignment="Center">
            <TextBlock Text="MODS" FontSize="11" FontWeight="SemiBold" Foreground="#8f87a3" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatModsText" Text="None" FontSize="13" FontWeight="Bold" Foreground="#f5f4fa" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Button x:Name="SettingsToggleButton" Classes="ghost-btn" Content="⚙ Settings ▼" Click="SettingsToggleButton_Click" HorizontalAlignment="Center"/>

      <Border x:Name="SettingsPanel" Classes="hud-card" IsVisible="False">
        <Grid ColumnDefinitions="*,*" Margin="0,4">
          <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Google Sheets" FontSize="12" FontWeight="SemiBold" Foreground="#8f87a3" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="credentials.json:" FontSize="10" Foreground="#8f87a3" VerticalAlignment="Center"/>
                <TextBlock x:Name="CredentialsLabel" Text="Found" FontSize="10" FontWeight="SemiBold" Foreground="#4ade80" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Spreadsheet ID" FontSize="11" Foreground="#8f87a3"/>
            <TextBox x:Name="SpreadsheetIdTextBox" Classes="osu-input" TextChanged="SpreadsheetIdTextBox_TextChanged"
                     ToolTip.Tip="The ID from your Google Sheets URL"/>

            <TextBlock Text="Sheet Name" FontSize="11" Foreground="#8f87a3"/>
            <TextBox x:Name="SheetNameTextBox" Classes="osu-input" TextChanged="SheetNameTextBox_TextChanged"
                     ToolTip.Tip="The tab name (default: Raw Data)"/>

            <Button x:Name="ConnectApiButton" Classes="primary-action" Content="Connect Google Sheets" Click="ConnectApiButton_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>

            <CheckBox x:Name="SoundEnabledCheckbox" Classes="osu-check" Content="Play sound on logging entry" IsCheckedChanged="SoundEnabledCheckbox_IsCheckedChanged"/>
            <CheckBox x:Name="AltSepCheckBox" Classes="osu-check" Content="Use ';' formula separator (fix #ERROR!)" IsCheckedChanged="AltSepCheckBox_IsCheckedChanged"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
            <TextBlock Text="tosu Settings" FontSize="12" FontWeight="SemiBold" Foreground="#8f87a3"/>

            <Grid ColumnDefinitions="*,8,80">
              <StackPanel Grid.Column="0">
                <TextBlock Text="tosu Host" FontSize="11" Foreground="#8f87a3"/>
                <TextBox x:Name="TosuHostTextBox" Classes="osu-input" Text="127.0.0.1" TextChanged="TosuHostTextBox_TextChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Port" FontSize="11" Foreground="#8f87a3"/>
                <TextBox x:Name="TosuPortTextBox" Classes="osu-input" Text="24050" TextChanged="TosuPortTextBox_TextChanged"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <Border Grid.Row="4" Background="#100e17" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="TimeLabelText" Grid.Column="0" Foreground="#8f87a3" FontSize="11" VerticalAlignment="Center" Text="Playing: 0s  Idle: 0s  Efficiency: 0%"/>
        <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Classes="osu-check" Content="Launch on Startup" IsCheckedChanged="StartupCheckBox_IsCheckedChanged"/>
      </Grid>
    </Border>
  </Grid>
</Window>
