<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Circle_Tracker.Views.ConfirmDialog"
        Width="420"
        SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDark}"
        CanResize="False">

  <StackPanel Spacing="16" Margin="24">
    <TextBlock x:Name="MessageText" Foreground="{StaticResource TextPrimary}" FontSize="14" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="No" Click="No_Click" Padding="24,8"/>
      <Button Classes="osu-action-pink" Content="Yes" Click="Yes_Click" Padding="24,8"/>
    </StackPanel>
  </StackPanel>
</Window>
