<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Circle_Tracker.ViewModels"
        xmlns:local="using:Circle_Tracker"
        xmlns:converters="using:Circle_Tracker.Converters"
        x:Class="Circle_Tracker.Views.AnalyticsWindow"
        x:DataType="vm:AnalyticsViewModel"
        Title="Circle Tracker — Analytics Dashboard"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}">

  <Window.Resources>
    <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter"/>
    <converters:PassFailTextConverter x:Key="PassFailTextConverter"/>
    <converters:PassFailBackgroundConverter x:Key="PassFailBackgroundConverter"/>
    <converters:PassFailForegroundConverter x:Key="PassFailForegroundConverter"/>
  </Window.Resources>

  <Panel>
    <local:TrianglesControl Velocity="4" TriangleCount="24" TriangleBrush="#0effffff" IsHitTestVisible="False"/>
    
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#cc1d192b" BorderBrush="#2e2744" BorderThickness="0,0,0,1" Padding="20,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <RadioButton GroupName="Tabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" Classes="tab-pill">
              <TextBlock Text="SKILL &amp; MECHANICS" FontWeight="Bold" FontSize="12"/>
            </RadioButton>
            <RadioButton GroupName="Tabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}" Classes="tab-pill">
              <TextBlock Text="SESSION DYNAMICS" FontWeight="Bold" FontSize="12"/>
            </RadioButton>
            <RadioButton GroupName="Tabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}" Classes="tab-pill">
              <TextBlock Text="TRENDS" FontWeight="Bold" FontSize="12"/>
            </RadioButton>
            <RadioButton GroupName="Tabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}" Classes="tab-pill">
              <TextBlock Text="CHOKES" FontWeight="Bold" FontSize="12"/>
            </RadioButton>
            <RadioButton GroupName="Tabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=4}" Classes="tab-pill">
              <TextBlock Text="EXPLORER" FontWeight="Bold" FontSize="12"/>
            </RadioButton>
          </StackPanel>
          
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button Classes="secondary-flat" Content="EXPORT" Command="{Binding ExportCsvCommand}" Padding="12,6"/>
            <Button Classes="ghost-btn" Content="✕" Click="CloseButton_Click" FontSize="16" Padding="10,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" IsVisible="{Binding IsLoading}" Background="#80000000" ZIndex="100">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentPurple}"/>
          <TextBlock Text="Loading analytics..." Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl Content="{Binding}">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <Panel>
                <ContentControl Content="{Binding}" IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <Grid Margin="20" ColumnDefinitions="1.1*,1*">
                        <Border Grid.Column="0" Margin="0,0,10,0" Classes="hud-card">
                          <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                              <TextBlock Text="STAR RATING MASTERY" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="13"/>
                              <TextBlock Text="Tapping accuracy on passed beatmaps across star difficulty brackets" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding StarMasteryBrackets}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Spacing="3" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Subtext}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                                      </StackPanel>
                                      <TextBlock Grid.Column="2" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold">
                                        <Run Text="{Binding MeanAccuracy, StringFormat={}{0:F1}%}"/>
                                        <Run Text=" (" Foreground="{StaticResource TextMuted}"/>
                                        <Run Text="{Binding ZoneLabel}"/>
                                        <Run Text=")" Foreground="{StaticResource TextMuted}"/>
                                      </TextBlock>
                                    </Grid>
                                    <ProgressBar Height="8" CornerRadius="4" Minimum="0" Maximum="100" 
                                                 Value="{Binding ProgressPercent}" Foreground="{Binding ZoneColor}" Background="#252038"/>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="16">
                          <Border Classes="hud-card">
                            <StackPanel Spacing="10">
                              <StackPanel Spacing="2">
                                <TextBlock Text="OD vs ACCURACY TIMING PRECISION" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Average accuracy &amp; ±ms 300-hit window across Overall Difficulty tiers" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                              </StackPanel>
                              <Grid ColumnDefinitions="Auto,*,Auto,80" Margin="0,4,0,2">
                                <TextBlock Grid.Column="0" Text="OD BRACKET" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="AVG ACC" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="3" Text="HIT WINDOW" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" TextAlignment="Right"/>
                              </Grid>
                              <Separator Background="#2e2744" Height="1" Margin="0,0,0,6"/>
                              <ItemsControl ItemsSource="{Binding OdPrecisionTiers}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,80" Margin="0,0,0,6">
                                      <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                      <TextBlock Grid.Column="2" Text="{Binding AvgAccuracy, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="Bold" Margin="0,0,16,0"/>
                                      <TextBlock Grid.Column="3" Text="{Binding HitWindow300Ms, StringFormat={}±{0:F0}ms}" Foreground="{StaticResource TextMuted}" FontSize="11" TextAlignment="Right"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                          <Border Classes="hud-card">
                            <StackPanel Spacing="10">
                              <StackPanel Spacing="2">
                                <TextBlock Text="BPM SPEED CEILING" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Tapping consistency &amp; miss density across song tempo brackets" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                              </StackPanel>
                              <Grid ColumnDefinitions="Auto,*,Auto,90" Margin="0,4,0,2">
                                <TextBlock Grid.Column="0" Text="TEMPO RANGE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="AVG ACC" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="3" Text="MISS RATE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" TextAlignment="Right"/>
                              </Grid>
                              <Separator Background="#2e2744" Height="1" Margin="0,0,0,6"/>
                              <ItemsControl ItemsSource="{Binding BpmSpeedBrackets}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,90" Margin="0,0,0,6">
                                      <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                      <TextBlock Grid.Column="2" Text="{Binding AvgAccuracy, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="Bold" Margin="0,0,16,0"/>
                                      <TextBlock Grid.Column="3" Text="{Binding MissDensityPer100, StringFormat={}{0:F1} / 100}" Foreground="{StaticResource AccentRed}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding}" IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <Grid Margin="20" RowDefinitions="Auto,*" ColumnDefinitions="*">
                        <Border Grid.Row="0" Classes="hud-card" Margin="0,0,0,16">
                          <StackPanel Spacing="16">
                            <TextBlock Text="CURRENT SESSION vs 30-DAY BASELINE OVERVIEW" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="13"/>
                            
                            <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,4,0,0">
                              <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="ACCURACY" Classes="stat-label"/>
                                <TextBlock Text="{Binding SessionBaseline.SessionAcc, StringFormat={}{0:F2}%}" Classes="hero-number" FontSize="22"/>
                                <TextBlock Text="{Binding SessionBaseline.Baseline30DAcc, StringFormat={}30D: {0:F2}%}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Background="{Binding SessionBaseline.DeltaAcc, Converter={StaticResource DeltaToColorConverter}}">
                                  <TextBlock Text="{Binding SessionBaseline.DeltaAcc, StringFormat={}{0:+0.00;-0.00}%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="DIFFICULTY" Classes="stat-label"/>
                                <TextBlock Text="{Binding SessionBaseline.SessionStars, StringFormat={}{0:F2}★}" Classes="hero-number" FontSize="22"/>
                                <TextBlock Text="{Binding SessionBaseline.Baseline30DStars, StringFormat={}30D: {0:F2}★}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Background="{Binding SessionBaseline.DeltaStars, Converter={StaticResource DeltaToColorConverter}}">
                                  <TextBlock Text="{Binding SessionBaseline.DeltaStars, StringFormat={}{0:+0.00;-0.00}★}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="PASS RATE" Classes="stat-label"/>
                                <TextBlock Text="{Binding SessionBaseline.SessionPassRate, StringFormat={}{0:F1}%}" Classes="hero-number" FontSize="22"/>
                                <TextBlock Text="{Binding SessionBaseline.Baseline30DPassRate, StringFormat={}30D: {0:F1}%}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Background="{Binding SessionBaseline.DeltaPassRate, Converter={StaticResource DeltaToColorConverter}}">
                                  <TextBlock Text="{Binding SessionBaseline.DeltaPassRate, StringFormat={}{0:+0.0;-0.0}%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                              </StackPanel>
                              <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Text="MAPS PLAYED" Classes="stat-label"/>
                                <TextBlock Text="{Binding SessionBaseline.SessionPlays}" Classes="hero-number" FontSize="22"/>
                                <TextBlock Text="{Binding SessionPlaysPerHour, StringFormat={}{0:F0} maps/hr pace}" Foreground="{StaticResource AccentGold}" FontSize="11" FontWeight="SemiBold"/>
                              </StackPanel>
                              <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Text="ACTIVE PLAY TIME" Classes="stat-label"/>
                                <TextBlock Text="{Binding SessionBaseline.SessionActiveMinutes, StringFormat={}{0:F1}m}" Classes="hero-number" FontSize="22"/>
                                <TextBlock Text="Excludes menus &amp; pauses" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Classes="hud-card">
                          <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                              <TextBlock Grid.Column="0" Text="MAPS PLAYED THIS SESSION" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="13"/>
                              <TextBlock Grid.Column="1" Text="{Binding SessionPlays.Count, StringFormat={}({0} logged attempts)}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="8,2,0,0"/>
                            </Grid>
                            <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                              <ItemsControl ItemsSource="{Binding SessionPlays}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="#252038" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center"
                                                Background="{Binding IsComplete, Converter={StaticResource PassFailBackgroundConverter}}">
                                          <TextBlock Text="{Binding IsComplete, Converter={StaticResource PassFailTextConverter}}"
                                                     Foreground="{Binding IsComplete, Converter={StaticResource PassFailForegroundConverter}}"
                                                     FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding BeatmapString}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                          <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ModsString}" Foreground="{StaticResource AccentPink}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Stars, StringFormat={}★ {0:F2}}" Foreground="{StaticResource AccentGold}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding TotalHits, StringFormat={}{0} hits}" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                          </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Accuracy, StringFormat={}{0:F2}%}" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TimestampUtc, StringFormat={}{0:t}}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding}" IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <Grid Margin="20" RowDefinitions="Auto,*" ColumnDefinitions="*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,16">
                          <Border Grid.Column="0" Margin="0,0,8,0" Classes="hud-card">
                            <StackPanel Spacing="8">
                              <TextBlock Text="7-DAY ROLLING" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="12"/>
                              <TextBlock Text="{Binding Rolling7Day.DateRangeText}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                              
                              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Avg Stars (Passes)</TextBlock>
                                  <TextBlock Text="{Binding Rolling7Day.AvgStars, StringFormat={}{0:F2}★}" Classes="hero-number" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Weighted Acc</TextBlock>
                                  <TextBlock Text="{Binding Rolling7Day.WeightedAccuracy, StringFormat={}{0:F1}%}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Pass Rate</TextBlock>
                                  <TextBlock Text="{Binding Rolling7Day.PassRatePercent, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentGreen}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Attempts/Day</TextBlock>
                                  <TextBlock Text="{Binding Rolling7Day.DailyPlayCount, StringFormat={}{0:F1}}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Hrs/Day</TextBlock>
                                  <TextBlock Text="{Binding Rolling7Day.DailyActiveHours, StringFormat={}{0:F2}h}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Avg BPM</TextBlock>
                                  <TextBlock Text="{Binding Rolling7Day.AvgBpm, StringFormat={}{0:F0}}" Foreground="{StaticResource AccentPink}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                              </Grid>
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="1" Margin="4,0,4,0" Classes="hud-card">
                            <StackPanel Spacing="8">
                              <TextBlock Text="30-DAY ROLLING" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12"/>
                              <TextBlock Text="{Binding Rolling30Day.DateRangeText}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                              <StackPanel IsVisible="{Binding !Rolling30Day.HasSufficientData}" Spacing="6" Margin="0,12,0,0">
                                <TextBlock Text="⚠ Insufficient History" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="Requires at least 30 days of recorded play history." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Rolling30Day.HistoryDaysAvailable, StringFormat={}Current database covers {0} days}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                              </StackPanel>
                              <Grid IsVisible="{Binding Rolling30Day.HasSufficientData}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Avg Stars (Passes)</TextBlock>
                                  <TextBlock Text="{Binding Rolling30Day.AvgStars, StringFormat={}{0:F2}★}" Classes="hero-number" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Weighted Acc</TextBlock>
                                  <TextBlock Text="{Binding Rolling30Day.WeightedAccuracy, StringFormat={}{0:F1}%}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Pass Rate</TextBlock>
                                  <TextBlock Text="{Binding Rolling30Day.PassRatePercent, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentGreen}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Attempts/Day</TextBlock>
                                  <TextBlock Text="{Binding Rolling30Day.DailyPlayCount, StringFormat={}{0:F1}}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Hrs/Day</TextBlock>
                                  <TextBlock Text="{Binding Rolling30Day.DailyActiveHours, StringFormat={}{0:F2}h}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Avg BPM</TextBlock>
                                  <TextBlock Text="{Binding Rolling30Day.AvgBpm, StringFormat={}{0:F0}}" Foreground="{StaticResource AccentPink}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                              </Grid>
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="2" Margin="8,0,0,0" Classes="hud-card">
                            <StackPanel Spacing="8">
                              <TextBlock Text="90-DAY ROLLING" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="12"/>
                              <TextBlock Text="{Binding Rolling90Day.DateRangeText}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                              <StackPanel IsVisible="{Binding !Rolling90Day.HasSufficientData}" Spacing="6" Margin="0,12,0,0">
                                <TextBlock Text="⚠ Insufficient History" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="Requires at least 90 days of recorded play history." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Rolling90Day.HistoryDaysAvailable, StringFormat={}Current database covers {0} days}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                              </StackPanel>
                              <Grid IsVisible="{Binding Rolling90Day.HasSufficientData}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Avg Stars (Passes)</TextBlock>
                                  <TextBlock Text="{Binding Rolling90Day.AvgStars, StringFormat={}{0:F2}★}" Classes="hero-number" FontSize="18"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Weighted Acc</TextBlock>
                                  <TextBlock Text="{Binding Rolling90Day.WeightedAccuracy, StringFormat={}{0:F1}%}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Pass Rate</TextBlock>
                                  <TextBlock Text="{Binding Rolling90Day.PassRatePercent, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentGreen}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Attempts/Day</TextBlock>
                                  <TextBlock Text="{Binding Rolling90Day.DailyPlayCount, StringFormat={}{0:F1}}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Hrs/Day</TextBlock>
                                  <TextBlock Text="{Binding Rolling90Day.DailyActiveHours, StringFormat={}{0:F2}h}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                  <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">Avg BPM</TextBlock>
                                  <TextBlock Text="{Binding Rolling90Day.AvgBpm, StringFormat={}{0:F0}}" Foreground="{StaticResource AccentPink}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                              </Grid>
                            </StackPanel>
                          </Border>
                        </Grid>
                        <Border Grid.Row="1" Classes="hud-card">
                          <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                              <TextBlock Text="DAILY ACTIVITY &amp; PERFORMANCE LOG (LAST 14 DAYS)" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="13"/>
                              <TextBlock Text="Day-by-day progression: accuracy and stars are computed strictly on completed passes" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="100,120,90,120,100,*" Margin="0,6,0,2">
                              <TextBlock Grid.Column="0" Text="DATE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                              <TextBlock Grid.Column="1" Text="PASSES / ATTEMPTS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                              <TextBlock Grid.Column="2" Text="PASS RATE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                              <TextBlock Grid.Column="3" Text="AVG ACC (PASSES)" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                              <TextBlock Grid.Column="4" Text="AVG STARS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                              <TextBlock Grid.Column="5" Text="ACTIVE TIME" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" TextAlignment="Right"/>
                            </Grid>
                            <Separator Background="#2e2744" Height="1" Margin="0,0,0,6"/>
                            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                              <ItemsControl ItemsSource="{Binding DailyTrends}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="#252038" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                      <Grid ColumnDefinitions="100,120,90,120,100,*">
                                        <TextBlock Grid.Column="0" Text="{Binding DateString}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center">
                                          <Run Text="{Binding Passes}" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                          <Run Text=" / " Foreground="{StaticResource TextMuted}"/>
                                          <Run Text="{Binding TotalAttempts}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding PassRatePercent, StringFormat={}{0:F1}%}" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AvgAccuracy, StringFormat={}{0:F2}%}" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding AvgStars, StringFormat={}{0:F2}★}" Foreground="{StaticResource AccentGold}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding ActiveMinutes, StringFormat={}{0:F0} min}" Foreground="{StaticResource TextMuted}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding}" IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <Grid Margin="20" ColumnDefinitions="*,*">
                        <Border Grid.Column="0" Margin="0,0,8,0" Classes="hud-card">
                          <StackPanel Spacing="12">
                            <TextBlock Text="TOP CHOKES (1-2 MISSES, ≥95% ACC)" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="13"/>
                            <ScrollViewer MaxHeight="600">
                              <ItemsControl ItemsSource="{Binding TopChokes}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="#252038" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                      <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding BeatmapString}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                          <TextBlock Grid.Column="0" Foreground="{StaticResource AccentRed}" FontSize="11" FontWeight="Bold">
                                            <Run Text="{Binding MinMisses}"/>
                                            <Run Text="x Miss"/>
                                          </TextBlock>
                                          <TextBlock Grid.Column="2" Text="{Binding BestAccuracy, StringFormat={}{0:F2}%}" Foreground="{StaticResource AccentGold}" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="8,0,0,0" Classes="hud-card">
                          <StackPanel Spacing="12">
                            <TextBlock Text="MOST GRINDED MAPS" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" FontSize="13"/>
                            <ScrollViewer MaxHeight="600">
                              <ItemsControl ItemsSource="{Binding MostGrinded}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="#252038" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                      <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding BeatmapString}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                          <TextBlock Grid.Column="0" Foreground="{StaticResource AccentOrange}" FontSize="11" FontWeight="Bold">
                                            <Run Text="{Binding TotalAttempts}"/>
                                            <Run Text=" attempts"/>
                                          </TextBlock>
                                          <TextBlock Grid.Column="2" Text="{Binding CumulativeHours, StringFormat={}{0:F1}h}" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding}" IsVisible="{Binding SelectedTabIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=4}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate>
                      <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
                        <Border Grid.Row="0" Background="#cc1d192b" BorderBrush="#2e2744" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search beatmaps..." Background="#252038" Foreground="{StaticResource TextPrimary}" BorderBrush="#2e2744" Padding="10,6" CornerRadius="6"/>
                            <Button Grid.Column="1" Classes="osu-action-pink" Content="SEARCH" Margin="10,0,0,0" Padding="20,6"/>
                          </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                          <TextBlock Text="Filter Mods:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                          <ToggleButton Content="NM" IsChecked="{Binding IsFilterNm}" Classes="secondary-flat" Padding="8,3"/>
                          <ToggleButton Content="HD" IsChecked="{Binding IsFilterHd}" Classes="secondary-flat" Padding="8,3"/>
                          <ToggleButton Content="HR" IsChecked="{Binding IsFilterHr}" Classes="secondary-flat" Padding="8,3"/>
                          <ToggleButton Content="DT" IsChecked="{Binding IsFilterDt}" Classes="secondary-flat" Padding="8,3"/>
                          <ToggleButton Content="FL" IsChecked="{Binding IsFilterFl}" Classes="secondary-flat" Padding="8,3"/>
                          <ToggleButton Content="EZ" IsChecked="{Binding IsFilterEz}" Classes="secondary-flat" Padding="8,3"/>
                          <ToggleButton Content="HT" IsChecked="{Binding IsFilterHt}" Classes="secondary-flat" Padding="8,3"/>
                        </StackPanel>

                        <Border Grid.Row="2" Classes="hud-card">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PlayHistory}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Background="#252038" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                      <!-- Status Badge -->
                                      <Border Grid.Column="0" CornerRadius="4" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center"
                                              Background="{Binding IsComplete, Converter={StaticResource PassFailBackgroundConverter}}">
                                        <TextBlock Text="{Binding IsComplete, Converter={StaticResource PassFailTextConverter}}"
                                                   Foreground="{Binding IsComplete, Converter={StaticResource PassFailForegroundConverter}}"
                                                   FontSize="10" FontWeight="Bold"/>
                                      </Border>
                                      <!-- Map Details -->
                                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BeatmapString}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                          <TextBlock Text="{Binding ModsString}" Foreground="{StaticResource AccentPink}" FontSize="10" FontWeight="Bold"/>
                                          <TextBlock Text="{Binding Stars, StringFormat={}★ {0:F2}}" Foreground="{StaticResource AccentGold}" FontSize="10" FontWeight="Bold"/>
                                          <TextBlock Text="{Binding TotalHits, StringFormat={}{0} hits}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        </StackPanel>
                                      </StackPanel>
                                      <!-- Accuracy -->
                                      <TextBlock Grid.Column="2" Text="{Binding Accuracy, StringFormat={}{0:F2}%}" Foreground="{StaticResource AccentCyan}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                                      <!-- Hit Counts -->
                                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Hit300}" Foreground="{StaticResource AccentCyan}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="/" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock Text="{Binding Hit100}" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="/" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock Text="{Binding Hit50}" Foreground="{StaticResource AccentOrange}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="/" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock Text="{Binding HitMiss}" Foreground="{StaticResource AccentRed}" FontSize="10" FontWeight="SemiBold"/>
                                      </StackPanel>
                                      <!-- Timestamp -->
                                      <TextBlock Grid.Column="4" Text="{Binding TimestampUtc, StringFormat={}{0:g}}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Border>

                        <Border Grid.Row="3" Background="#cc1d192b" BorderBrush="#2e2744" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                              <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
                                <Run Text="Total:"/>
                                <Run Text="{Binding TotalMatches}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                              </TextBlock>
                              <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
                                <Run Text="Avg Acc:"/>
                                <Run Text="{Binding SubsetAvgAccuracy, StringFormat={}{0:F1}%}" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                              </TextBlock>
                              <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
                                <Run Text="Avg Stars:"/>
                                <Run Text="{Binding SubsetAvgStars, StringFormat={}{0:F2}★}" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                              </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                              <Button Classes="secondary-flat" Content="◀ Prev" Command="{Binding PreviousPageCommand}" Padding="10,4"/>
                              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11">
                                <Run Text="Page"/>
                                <Run Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <Run Text="of"/>
                                <Run Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                              </TextBlock>
                              <Button Classes="secondary-flat" Content="Next ▶" Command="{Binding NextPageCommand}" Padding="10,4"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Panel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </ScrollViewer>
    </Grid>
  </Panel>
</Window>
